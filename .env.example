# Required application settings
WC_SESSION_SECRET=replace-with-at-least-32-random-characters
WC_ADMIN_USER=admin
WC_ADMIN_PASSWORD=replace-with-a-strong-password
WC_DB_PATH=/data/webconsole.db
WC_PROJECTS_ROOT=/projects

# Web listener
WC_LISTEN_HOST=127.0.0.1
WC_HOST=127.0.0.1
WC_PORT=8080
# Set to 1 only for plain HTTP on a trusted private network such as Tailscale.
WC_COOKIE_ALLOW_INSECURE=0

# Host-side Claude Code proxy
WC_PROXY_ENABLED=1
WC_PROXY_HOST=127.0.0.1
WC_PROXY_LISTEN_HOST=127.0.0.1
WC_PROXY_PORT=9000
WC_PROXY_CONNECT_TIMEOUT_S=10
WC_PROXY_TURN_TIMEOUT_S=300
WC_PROXY_TOKEN=replace-with-an-independent-random-token
WC_PROXY_FALLBACK_DIR=/tmp
WC_CLAUDE_PATH=claude
# WC_CLAUDE_MODEL=claude-opus-5

# Limits
WC_MAX_CONCURRENT=3
WC_TURN_TIMEOUT_S=300
WC_PROMPT_MAX_CHARS=8000
# Ceiling on a single request body, in bytes (default 500 MB).
WC_MAX_UPLOAD_BYTES=524288000
WC_SESSION_TTL_S=7200
WC_SESSION_IDLE_S=1800
WC_SESSION_MAX=50
WC_LOGIN_RATE_MAX=10
WC_LOGIN_RATE_WIN=300
WC_LOGIN_BACKOFF=30

# Direct mode only (WC_PROXY_ENABLED=0)
WC_MODEL_BASE_URL=http://127.0.0.1:11434/v1
WC_MODEL_API_KEY=
WC_MODEL_NAME=claude-sonnet-5
