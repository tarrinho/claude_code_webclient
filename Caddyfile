# WebConsole HTTPS reverse proxy via Tailscale
# Caddy automatically requests TLS certs from its built-in TLS CA
# for *.tailnet and *.ts.net domains.

kali-2.tail850c40.ts.net {

	# Serve static assets with caching
	handle /assets/* {
		file_server {
			root /home/kali/projects/claude-code-webconsole/web/assets
		}
		header Cache-Control "public, max-age=3600"
		header X-Content-Type-Options "nosniff"
	}

	# SSE streaming
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto "https"
	}
}