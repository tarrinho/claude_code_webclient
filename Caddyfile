# WebConsole HTTPS reverse proxy via Tailscale
# Caddy automatically requests TLS certs from its built-in TLS CA
# for *.tailnet and *.ts.net domains.

kali-2.tail850c40.ts.net:443 {

	# Gzip compression
	encode gzip

	# Serve static assets with caching
	handle_path /assets/* {
		file server {
			root * /home/kali/projects/claude-code-webconsole/web/assets
		}
		header Cache-Control "public, max-age=3600"
		header X-Content-Type-Options "nosniff"
	}

	# Reverse proxy to FastAPI
	# WebConsole on localhost:8080 (plain HTTP, Caddy terminates TLS)
	# Cookie insecure is safe here because Caddy provides HTTPS
	reverse_proxy 127.0.0.1:8080 {
		header_up X-Real-IP {remote_host}
		header_up X-Forwarded-Proto "https"
		header_up X-Forwarded-Host {host}

		# SSE streaming — increased buffer for long-running turns
		read_buffer_size 1024000
		write_buffer_size 1024000
	}
}