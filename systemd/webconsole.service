[Unit]
Description=WebConsole web application
# Wants, not Requires: if the proxy is down the site should still come up and
# say so, rather than vanishing and leaving nothing to read the error in.
Wants=webconsole-proxy.service
After=webconsole-proxy.service network-online.target
PartOf=webconsole.target
# In [Unit], not [Service], and that is the whole point: systemd only honours
# these here. Sitting in [Service] they were silently ignored, and the
# effective window stayed systemd's 10s default rather than the 60s written
# down. Measured 2026-09-10: with each failed attempt taking ~7s (~4s of
# runtime plus RestartSec=3), barely one start falls inside a 10s window, so
# the burst of 5 was never reached and the loop could not stop itself -- the
# service restarted 121 times over about fourteen minutes against a port that
# was already in use. 60s is wide enough to hold ~8 attempts, so it trips.
#
# The consequence of it working is that a genuinely broken service now stops
# and stays failed instead of hammering the host, and clearing it takes
# `systemctl --user reset-failed webconsole.service`. Failing visibly is the
# point: fourteen minutes of silent looping is what this prevents.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=exec
WorkingDirectory=%h/projects/claude-code-webconsole
# launch.sh resolves the tailnet address, the certificate and the proxy token.
# WC_EXEC makes it exec uvicorn instead of backgrounding it, so systemd
# supervises the server rather than a shell that has already exited.
Environment=WC_EXEC=1
ExecStart=/usr/bin/env bash launch.sh proxy
Restart=always
RestartSec=3
# StartLimitIntervalSec / StartLimitBurst live in [Unit] above -- systemd
# ignores them here, which is exactly the bug that let this loop 121 times.
# Decline the user manager's DefaultOOMScoreAdjust=200, which made this the
# host's preferred OOM victim: measured 2026-09-10, the service sat at
# oom_score 813 on 141MB while seven claude CLIs sat at 698-709 on 167-366MB
# each -- the process using the least memory was first in line to be killed,
# purely because of the +200. That is a priority inversion. A killed CLI
# resumes from its transcript; a killed webconsole takes every session's UI
# down with it, and each kill cold-starts the transcript caches, whose first
# scans spike memory and invite the next kill. It was SIGKILLed twice in ten
# minutes that morning.
#
# Asks for 0 and gets 100, measured: the user manager runs at adj 100 and
# lowering below its own value needs CAP_SYS_RESOURCE, which it does not
# have. The kernel clamps silently -- systemd reports OOMScoreAdjust=0 while
# /proc/<pid>/oom_score_adj reads 100 and nothing is logged. Worth keeping
# anyway: it took the score from 813 to 746, it costs nothing, and it takes
# full effect if this ever runs under a privileged manager or the
# DefaultOOMScoreAdjust goes away.
#
# 746 is still above the CLIs at 698-709, so this is only half the fix. The
# other half cannot live here, because a service cannot lower itself below
# its manager: bin/wc-claude.sh raises each interactive CLI's own score
# instead, which is always permitted. See the comment there.
OOMScoreAdjust=0
# Application records go to logs/webconsole.log via logging.conf's rotating
# handler; this captures uvicorn's own access lines, which only reach stdout.
StandardOutput=append:%h/projects/claude-code-webconsole/logs/uvicorn.out.log
StandardError=inherit

[Install]
WantedBy=default.target
